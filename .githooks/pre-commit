#!/usr/bin/env bash
# Native git pre-commit hook — fast local gate: rustfmt check plus a betterleaks
# scan of staged changes (see `just precommit`).
# Enable once per clone:  just hooks   (sets core.hooksPath=.githooks)
#
# Bypass in an emergency:  git commit --no-verify   (avoid; prefer fixing the cause)
set -euo pipefail

if ! command -v just >/dev/null 2>&1; then
  echo "pre-commit: 'just' is not installed — install with 'brew install just'." >&2
  exit 1
fi

exec just precommit
